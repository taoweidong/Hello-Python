# 应用配置模板：复制为 .env 后按需修改
APP_NAME="Hello-Python"
APP_VERSION="1.0.0"
APP_ENV="development"

# 日志配置
LOG_LEVEL="INFO"
LOG_DIR="logs"

# 数据目录
DATA_INPUT_PATH="data/input"
DATA_OUTPUT_PATH="data/output"
DATA_SAMPLES_PATH="data/samples"

# 数据库配置
DATABASE_URL="sqlite:///./data/app.db"
DATABASE_ECHO="false"

# 调试
DEBUG="false"
